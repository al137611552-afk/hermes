{"type": "tool_use", "meta": {"call": {"id": "call_01_F50dlDa6cIZMQuBFY3Tb9037", "name": "write_file", "input": {"content": "#!/usr/bin/env python3\n\"\"\"wordstat 的测试：覆盖两个函数与边界，全通过时打印 ALL TESTS PASSED。\"\"\"\n\nimport sys\n\nfrom wordstat import count_words, top_n\n\nPASSED = 0\n\n\ndef check(name, actual, expected):\n    global PASSED\n    assert actual == expected, f\"{name}: 期望 {expected!r}，实际 {actual!r}\"\n    PASSED += 1\n    print(f\"ok - {name}\")\n\n\n# --- count_words ---\ncheck(\n    \"基本统计\",\n    count_words(\"the cat sat on the mat\"),\n    {\"the\": 2, \"cat\": 1, \"sat\": 1, \"on\": 1, \"mat\": 1},\n)\n\ncheck(\n    \"忽略大小写\",\n    count_words(\"Hello HELLO hello\"),\n    {\"hello\": 3},\n)\n\ncheck(\n    \"剥掉词首尾标点\",\n    count_words(\"Hello, world! (hello) \\\"world\\\".\"),\n    {\"hello\": 2, \"world\": 2},\n)\n\ncheck(\n    \"按空白切词\",\n    count_words(\"a\\tb\\nc  d\"),\n    {\"a\": 1, \"b\": 1, \"c\": 1, \"d\": 1},\n)\n\ncheck(\n    \"空文本\",\n    count_words(\"\"),\n    {},\n)\n\ncheck(\n    \"全标点文本\",\n    count_words(\"!!! ... ???\"),\n    {},\n)\n\n# --- top_n ---\ncheck(\n    \"次数降序\",\n    top_n({\"a\": 1, \"b\": 3, \"c\": 2}, 3),\n    [(\"b\", 3), (\"c\", 2), (\"a\", 1)],\n)\n\ncheck(\n    \"同次数按词升序\",\n    top_n({\"b\": 2, \"a\": 2, \"c\": 2}, 3),\n    [(\"a\", 2), (\"b\", 2), (\"c\", 2)],\n)\n\ncheck(\n    \"n 大于词数\",\n    top_n({\"a\": 1, \"b\": 1}, 10),\n    [(\"a\", 1), (\"b\", 1)],\n)\n\ncheck(\n    \"n 为 0\",\n    top_n({\"a\": 1}, 0),\n    [],\n)\n\ncheck(\n    \"空 counts\",\n    top_n({}, 3),\n    [],\n)\n\n# --- 集成：count_words + top_n 连用 ---\ncheck(\n    \"集成\",\n    top_n(count_words(\"apple banana apple cherry banana apple\"), 2),\n    [(\"apple\", 3), (\"banana\", 2)],\n)\n\nprint(\"ALL TESTS PASSED\")\nsys.exit(0)\n", "path": "run_tests.py"}}}}
