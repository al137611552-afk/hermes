{"type": "tool_use", "meta": {"call": {"id": "call_00_mEOXlyu5HzQEyyHahns55983", "name": "write_file", "input": {"path": "shop/coupon.py", "content": "\"\"\"优惠券：按券码对金额打折/立减。\"\"\"\n\n# 已支持的券码\n_COUPONS = (\"SAVE20\", \"HALF\")\n\n\ndef apply_coupon(amount, code):\n    \"\"\"按券码计算折后金额，四舍五入到分。\n\n    - SAVE20：立减 20 元，减到 0 为止、不为负；\n    - HALF：打五折；\n    - 其他券码抛 ValueError。\n    \"\"\"\n    if code == \"SAVE20\":\n        return round(max(0.0, amount - 20), 2)\n    if code == \"HALF\":\n        return round(amount * 0.5, 2)\n    raise ValueError(f\"未知优惠券码: {code!r}\")\n"}}}}
