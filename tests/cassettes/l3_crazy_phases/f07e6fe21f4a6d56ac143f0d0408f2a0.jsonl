{"type": "tool_use", "meta": {"call": {"id": "call_01_ubpTzNP7WnZ6JmH5Gnvw9780", "name": "write_file", "input": {"path": "shop/coupon.py", "content": "\"\"\"优惠券：按券码对金额打折。\"\"\"\n\n\ndef apply_coupon(amount, code):\n    \"\"\"对金额应用优惠券，返回优惠后金额（四舍五入到分）。\n\n    - SAVE20：立减 20 元，减到 0 为止、不为负；\n    - HALF：打五折；\n    - 其它券码抛 ValueError。\n    \"\"\"\n    if code == \"SAVE20\":\n        return round(max(0.0, amount - 20), 2)\n    if code == \"HALF\":\n        return round(amount * 0.5, 2)\n    raise ValueError(f\"未知券码：{code}\")\n"}}}}
