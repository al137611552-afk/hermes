{"type": "tool_use", "meta": {"call": {"id": "call_00_rdCHCgB8MS1mo2xUEyWV3504", "name": "write_file", "input": {"path": "shop/coupon.py", "content": "\"\"\"优惠券规则：SAVE20 满减、HALF 五折。\"\"\"\n\n\ndef apply_coupon(amount, code):\n    \"\"\"按券码折算金额。\n\n    - SAVE20：立减 20 元，减到 0 为止（结果不为负）\n    - HALF：打五折\n    - 其它券码抛 ValueError\n    \"\"\"\n    if amount < 0:\n        raise ValueError(\"金额不能为负\")\n    if code == \"SAVE20\":\n        return max(0.0, round(amount - 20, 2))\n    if code == \"HALF\":\n        return round(amount / 2, 2)\n    raise ValueError(f\"未知券码: {code}\")\n"}}}}
